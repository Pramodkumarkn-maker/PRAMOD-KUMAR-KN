#include <iostream>
#include <algorithm>
using namespace std;

struct Edge
{
    int u, v, weight;
};

int parent[10];

int find(int x)
{
    if (parent[x] == x)
        return x;

    return parent[x] = find(parent[x]);
}

void unite(int a, int b)
{
    int rootA = find(a);
    int rootB = find(b);

    parent[rootB] = rootA;
}

int main()
{
    int n, e;
    Edge edge[20];

    cout << "Enter number of vertices: ";
    cin >> n;

    cout << "Enter number of edges: ";
    cin >> e;

    cout << "Enter edges (u v weight):\n";

    for (int i = 0; i < e; i++)
    {
        cin >> edge[i].u >> edge[i].v >> edge[i].weight;
    }

    sort(edge, edge + e, [](Edge a, Edge b)
    {
        return a.weight < b.weight;
    });

    for (int i = 0; i < n; i++)
        parent[i] = i;

    int total = 0, count = 0;

    cout << "\nEdges in Minimum Spanning Tree:\n";

    for (int i = 0; i < e && count < n - 1; i++)
    {
        int u = edge[i].u;
        int v = edge[i].v;

        if (find(u) != find(v))
        {
            cout << u << " - " << v
                 << " : " << edge[i].weight << endl;

            total += edge[i].weight;
            unite(u, v);
            count++;
        }
    }

    if (count != n - 1)
        cout << "MST is not possible";
    else
        cout << "\nMinimum Cost = " << total;

    return 0;
}
