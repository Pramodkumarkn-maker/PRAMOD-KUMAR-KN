#include <iostream>
#include <vector>
#include <queue>
#include <chrono>

using namespace std;

class GraphTraversal {
private:
    int vertices;
    vector<vector<int>> graph;

public:
    GraphTraversal(int n) : vertices(n) {
        graph.resize(n);
    }

    void connect(int a, int b) {
        graph[a].push_back(b);
        graph[b].push_back(a);
    }

    void depthFirst(int current, vector<bool>& marked) {
        marked[current] = true;
        cout << current << " ";

        for (int next : graph[current]) {
            if (!marked[next]) {
                depthFirst(next, marked);
            }
        }
    }

    void runDFS(int source) {
        vector<bool> marked(vertices, false);
        depthFirst(source, marked);
    }

    void runBFS(int source) {
        vector<bool> marked(vertices, false);
        queue<int> nodes;

        marked[source] = true;
        nodes.push(source);

        while (!nodes.empty()) {
            int current = nodes.front();
            nodes.pop();

            cout << current << " ";

            for (int next : graph[current]) {
                if (!marked[next]) {
                    marked[next] = true;
                    nodes.push(next);
                }
            }
        }
    }
};

int main() {
    int vertices, edges;

    cout << "Enter number of vertices: ";
    cin >> vertices;

    GraphTraversal graph(vertices);

    cout << "Enter number of edges: ";
    cin >> edges;

    cout << "Enter edges (u v):\n";

    for (int i = 0; i < edges; ++i) {
        int from, to;
        cin >> from >> to;
        graph.connect(from, to);
    }

    int source;
    cout << "Enter starting vertex: ";
    cin >> source;

    // Measure DFS execution time
    auto dfsBegin = chrono::high_resolution_clock::now();

    cout << "\nDFS Traversal: ";
    graph.runDFS(source);

    auto dfsFinish = chrono::high_resolution_clock::now();

    auto dfsDuration =
        chrono::duration_cast<chrono::nanoseconds>(
            dfsFinish - dfsBegin
        );

    // Measure BFS execution time
    auto bfsBegin = chrono::high_resolution_clock::now();

    cout << "\n\nBFS Traversal: ";
    graph.runBFS(source);

    auto bfsFinish = chrono::high_resolution_clock::now();

    auto bfsDuration =
        chrono::duration_cast<chrono::nanoseconds>(
            bfsFinish - bfsBegin
        );

    cout << "\n\nExecution Time:";
    cout << "\nDFS: " << dfsDuration.count() << " ns";
    cout << "\nBFS: " << bfsDuration.count() << " ns";

    return 0;
}
