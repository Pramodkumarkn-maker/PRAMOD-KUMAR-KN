#include <iostream>
using namespace std;

int main()
{
    int n, graph[10][10];

    cout << "Enter number of vertices: ";
    cin >> n;

    cout << "Enter the adjacency matrix:\n";

    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            cin >> graph[i][j];

    bool visited[10] = {false};
    visited[0] = true;

    int count = 0, cost = 0;

    cout << "\nEdges in Minimum Spanning Tree:\n";

    while (count < n - 1)
    {
        int minCost = 9999;
        int from = -1, to = -1;

        for (int i = 0; i < n; i++)
        {
            if (visited[i])
            {
                for (int j = 0; j < n; j++)
                {
                    if (!visited[j] && graph[i][j] != 0 &&
                        graph[i][j] < minCost)
                    {
                        minCost = graph[i][j];
                        from = i;
                        to = j;
                    }
                }
            }
        }

        if (to == -1)
        {
            cout << "Minimum Spanning Tree is not possible.\n";
            return 0;
        }

        cout << from << " - " << to << " : " << minCost << endl;

        cost = cost + minCost;
        visited[to] = true;
        count++;
    }

    cout << "Minimum Cost = " << cost << endl;

    return 0;
}
